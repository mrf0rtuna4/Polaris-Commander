<Window
    x:Class="PolarisCommander.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Polaris Commander">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="#1E1E1E">

            <StackPanel Padding="12" Spacing="8">

                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Text="Polaris Commander" />

                <Button Content="Home" />
                <Button Content="Downloads" />
                <Button Content="Documents" />
                <Button Content="FTP" />
                <Button Content="SFTP" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Padding="12"
                ColumnSpacing="12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Text="{Binding CurrentPath, Mode=TwoWay}" />

                <Button
                    Grid.Column="1"
                    Command="{Binding LoadCommand}"
                    Content="Open" />
            </Grid>

            <ListView
                Grid.Row="1"
                ItemsSource="{Binding Items}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="{Binding Name}" />

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Size}" />

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding Modified}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>